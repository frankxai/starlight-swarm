+  "supportBoundary": "Includes package install guidance, runtime dry-run proof, and operator doctrine. Does not include private Starlight memory, credentials, production payment keys, guaranteed income, or investment rights.",
+  "upgradePath": [
+    "Operator Pack v0.2 with marketplace entitlement resolver",
+    "Certified Operator Agent identity layer",
+    "Enterprise swarm governance and support"
+  ]
+}
