{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "starlight.team_runtime_plan.v2"
    },
    "team_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_profile": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "schema_version": {
          "type": "string",
          "const": "starlight.team_profile.v2"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "schema_version",
        "version",
        "review_date",
        "sha256"
      ],
      "additionalProperties": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "activation_status": {
      "type": "string",
      "const": "planned-human-approval-required"
    },
    "authority": {
      "type": "object",
      "properties": {
        "mission": {
          "type": "string",
          "const": "per-workflow"
        },
        "model_policy": {
          "type": "string",
          "const": "queen-model-policy"
        },
        "observability": {
          "type": "string",
          "const": "langfuse"
        },
        "integration": {
          "type": "string",
          "const": "n8n"
        },
        "operator": {
          "type": "string",
          "const": "hermes"
        }
      },
      "required": [
        "mission",
        "model_policy",
        "observability",
        "integration",
        "operator"
      ],
      "additionalProperties": false
    },
    "routing_policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "policy_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "eve_allowlisted_workload_ids": {
          "type": "array",
          "items": false,
          "maxItems": 0
        },
        "allowed_runtimes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cloudflare-workflows",
              "vercel-workflow",
              "railway-worker",
              "hermes-local",
              "n8n-integration"
            ]
          }
        }
      },
      "required": [
        "policy_id",
        "policy_digest_sha256",
        "eve_allowlisted_workload_ids",
        "allowed_runtimes"
      ],
      "additionalProperties": false
    },
    "workflow_ownership": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workflow_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "workload_scope": {
            "type": "string",
            "enum": [
              "agent-centric",
              "cross-service",
              "app-local"
            ]
          },
          "identity_state_owner": {
            "type": "string",
            "enum": [
              "cloudflare",
              "vercel"
            ]
          },
          "durable_engine": {
            "type": "string",
            "enum": [
              "cloudflare-workflows",
              "vercel-workflow"
            ]
          }
        },
        "required": [
          "workflow_id",
          "workload_scope",
          "identity_state_owner",
          "durable_engine"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "oneOf": [
              {
                "properties": {
                  "workload_scope": {
                    "enum": [
                      "agent-centric",
                      "cross-service"
                    ]
                  },
                  "identity_state_owner": {
                    "const": "cloudflare"
                  },
                  "durable_engine": {
                    "const": "cloudflare-workflows"
                  }
                }
              },
              {
                "properties": {
                  "workload_scope": {
                    "const": "app-local"
                  },
                  "identity_state_owner": {
                    "const": "vercel"
                  },
                  "durable_engine": {
                    "const": "vercel-workflow"
                  }
                }
              }
            ]
          }
        ]
      },
      "uniqueItems": true
    },
    "human_gate_actions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "max_daily_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "planned_daily_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "policy_id",
        "max_daily_cost_usd",
        "planned_daily_cost_usd"
      ],
      "additionalProperties": false
    },
    "lanes": {
      "minItems": 3,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "role_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "workflow_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "workload_contract": {
            "type": "object",
            "properties": {
              "workload_class": {
                "type": "string",
                "enum": [
                  "durable-mission",
                  "interactive-specialist",
                  "scheduled-intelligence",
                  "integration-automation",
                  "edge-session"
                ]
              },
              "interaction": {
                "type": "string",
                "enum": [
                  "async",
                  "realtime",
                  "scheduled",
                  "event-driven"
                ]
              },
              "durability": {
                "type": "string",
                "enum": [
                  "ephemeral",
                  "session",
                  "run-receipt",
                  "checkpointed"
                ]
              },
              "approval_waits": {
                "type": "boolean"
              },
              "code_execution": {
                "type": "boolean"
              },
              "third_party_connections": {
                "type": "boolean"
              },
              "local_private_data": {
                "type": "boolean"
              },
              "always_available": {
                "type": "boolean"
              },
              "risk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "required": [
              "workload_class",
              "interaction",
              "durability",
              "approval_waits",
              "code_execution",
              "third_party_connections",
              "local_private_data",
              "always_available",
              "risk"
            ],
            "additionalProperties": false
          },
          "runtime": {
            "type": "string",
            "enum": [
              "cloudflare-workflows",
              "vercel-workflow",
              "railway-worker",
              "hermes-local",
              "n8n-integration"
            ]
          },
          "mission_authority": {
            "type": "string",
            "enum": [
              "cloudflare-workflows",
              "vercel-workflow"
            ]
          },
          "provider_route": {
            "type": "string",
            "enum": [
              "direct-provider",
              "vercel-ai-gateway",
              "hermes-profile",
              "none"
            ]
          },
          "model_route": {
            "type": "string",
            "enum": [
              "economy",
              "balanced",
              "frontier",
              "checker-independent"
            ]
          },
          "budget": {
            "type": "object",
            "properties": {
              "daily_token_cap": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "daily_cost_cap_usd": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "daily_token_cap",
              "daily_cost_cap_usd"
            ],
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "const": "dry-run"
          },
          "independent_verifier": {
            "type": "boolean"
          },
          "reason_codes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "warnings": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "role_id",
          "workflow_id",
          "workload_contract",
          "runtime",
          "mission_authority",
          "provider_route",
          "model_route",
          "budget",
          "mode",
          "independent_verifier",
          "reason_codes",
          "warnings"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "workload_contract": {
                  "properties": {
                    "local_private_data": {
                      "const": true
                    }
                  },
                  "required": [
                    "local_private_data"
                  ]
                }
              },
              "required": [
                "workload_contract"
              ]
            },
            "then": {
              "properties": {
                "runtime": {
                  "const": "hermes-local"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "team_id",
    "source_profile",
    "generated_at",
    "activation_status",
    "authority",
    "routing_policy",
    "workflow_ownership",
    "human_gate_actions",
    "budget",
    "lanes"
  ],
  "additionalProperties": false,
  "$id": "https://starlight.local/schemas/starlight.team_runtime_plan.v2.schema.json",
  "$comment": "STRUCTURAL EXPORT ONLY. Exact ownership, source, role, budget and compiler bindings require the runtime parser and canonical verifier. This export grants no operation authority. Expressible ownership/privacy and exact-object duplicate rules are included; keyed-ID uniqueness, cross-references, exact budget sums and provenance still require the canonical runtime parser/verifier.",
  "x-starlight-validation-authority": "export-only-runtime-parser-required"
}
