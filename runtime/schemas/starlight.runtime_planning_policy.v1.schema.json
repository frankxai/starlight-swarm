{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight.local/schemas/starlight.runtime_planning_policy.v1.schema.json",
  "title": "Starlight Runtime Planning Policy v1",
  "$comment": "STRUCTURAL EXPORT ONLY. Admission MUST use parseRuntimePlanningPolicy and authority-owned policy provenance; JSON Schema validation alone is insufficient.",
  "x-starlight-validation-authority": "export-only-runtime-parser-required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "budget_policy_id",
    "max_daily_cost_usd",
    "team_profile_source",
    "eve_allowlisted_workload_ids",
    "allowed_runtimes",
    "deferred_runtimes",
    "activation_mode",
    "review_date"
  ],
  "properties": {
    "schema_version": { "const": "starlight.runtime_planning_policy.v1" },
    "policy_id": { "$ref": "#/$defs/id" },
    "budget_policy_id": { "$ref": "#/$defs/id" },
    "max_daily_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
    "team_profile_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "path"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commit_sha": { "type": "string", "pattern": "^(?!0{40}$)[a-f0-9]{40}$" },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" }
      }
    },
    "eve_allowlisted_workload_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "allowed_runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["railway-temporal", "vercel-eve", "hermes-local", "n8n-integration"]
      },
      "uniqueItems": true
    },
    "deferred_runtimes": {
      "type": "array",
      "items": {
        "enum": [
          "railway-temporal",
          "vercel-eve",
          "hermes-local",
          "n8n-integration",
          "cloudflare-agents"
        ]
      },
      "uniqueItems": true
    },
    "activation_mode": { "const": "dry-run-only" },
    "review_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
  }
}
